from google.cloud import workstations_v1
from google.oauth2 import service_account

def get_workstation_client():
    credentials = service_account.Credentials.from_service_account_file(
        'path/to/service-account-key.json'
    )
    return workstations_v1.WorkstationsClient(credentials=credentials)

def start_workstation(project_id, region, cluster_id, config_id, workstation_id):
    client = get_workstation_client()
    
    workstation_name = f"projects/{project_id}/locations/{region}/workstationClusters/{cluster_id}/workstationConfigs/{config_id}/workstations/{workstation_id}"
    
    operation = client.start_workstation(name=workstation_name)
    response = operation.result(timeout=300)
    
    print(f"Workstation {workstation_id} started successfully")
    return response

# Usage
start_workstation(
    project_id="monospace-10",
    region="asia-east1",
    cluster_id="workstation-cluster-5",
    config_id="monospace-config-web",
    workstation_id="idx-studio-1746147003713"
)
                            </code></pre>
